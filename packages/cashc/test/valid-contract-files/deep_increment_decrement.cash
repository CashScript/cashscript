contract DeepIncrementDecrement() {
    function loop(int budget) {
        int remaining = budget;
        int steps = 0;
        int a = 1;
        int b = 2;
        int c = 3;

        for (int i = 0; i < 3; i++) {
            remaining = remaining - 1;
            steps = steps + 1;
        }

        require(a + b + c == 6);
        require(remaining + steps == budget);
    }

    function branch(int x, int y, int z) {
        if (x > y) {
            x = x - 1;
            y = y - 1;
            z = z - 1;
        }

        require(x + y + z > 0);
    }
}
